# 模型配置（OpenAI 兼容接口，适配大多数提供商）
OPTIMIZER_API_BASE=https://api.openai.com/v1
OPTIMIZER_API_KEY=sk-your-key-here
OPTIMIZER_MODEL=gpt-4o-mini

# 示例 - Ollama 本地
# OPTIMIZER_API_BASE=http://localhost:11434/v1
# OPTIMIZER_API_KEY=ollama
# OPTIMIZER_MODEL=qwen2.5:7b

# 示例 - DeepSeek
# OPTIMIZER_API_BASE=https://api.deepseek.com/v1
# OPTIMIZER_API_KEY=sk-your-deepseek-key
# OPTIMIZER_MODEL=deepseek-chat

# 示例 - SiliconFlow
# OPTIMIZER_API_BASE=https://api.siliconflow.cn/v1
# OPTIMIZER_API_KEY=sk-your-siliconflow-key
# OPTIMIZER_MODEL=Qwen/Qwen2.5-14B-Instruct
